<Window x:Class="AuroraPAR.DisplayStyleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora PAR - Display style" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="AuroraPAR.ico">
    <StackPanel Margin="12">
        <TabControl Name="Tabs">
            <TabItem Header="Range marks">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="Gray"
                               Text="Each ticked box draws those lines with their own style (Colours &amp; lines tab). Where ticked boxes overlap (e.g. 1 NM is also a ½ and a ¼ mile), the largest one wins. Changes are applied immediately."/>
                    <Grid Name="RangeMarkGrid" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Distance text:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton Name="DecimalRadio" GroupName="DistanceText" Content="Decimal (1.25NM)" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton Name="FractionsRadio" GroupName="DistanceText" Content="Fractions (1 1/4NM)" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Text size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Name="TextSizeComboBox" Width="70" Height="22" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Name="RangeMarksDefaultButton" Content="Default" HorizontalAlignment="Left" Width="80" Height="26" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Colours &amp; lines">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="Gray"
                               Text="Modern display: colour, line style and width of each element. Plots are the history dots, tracks the aircraft symbols. Modern / Analog (last two columns): draw the line or not, separately in the modern display and on the analog scope (e.g. no approach limit lines, as on many old scopes; the track colour still follows the limits). Changes are applied immediately."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Margin="0,10,0,0">
                        <Grid Name="StyleGrid"/>
                    </ScrollViewer>
                    <Button Name="StyleDefaultButton" Content="Default" HorizontalAlignment="Left" Width="80" Height="26" Margin="0,10,0,0"/>
                    <GroupBox Header="Analog scope" Padding="8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" MaxWidth="580" Foreground="Gray"
                                       Text="The analog scope has a fixed theme: choose the colour of its phosphor, all the elements use it with different brightness."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Phosphor:" VerticalAlignment="Center"/>
                                <ComboBox Name="PhosphorComboBox" Width="190" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Reminders">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" Foreground="Gray"
                               Text="Distance reminders for all runways: a marker above the distance in the elevation view, a coloured line across both views (it replaces the range mark at that distance), or both. Each runway can also have its own reminders, in Runways... . Changes are applied immediately."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Horizon line:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton Name="MarkersAboveRadio" GroupName="MarkerPosition" Content="distance text above, markers below" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton Name="MarkersBelowRadio" GroupName="MarkerPosition" Content="distance text below, markers above" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ContentControl Name="RemindersHost" Margin="0,10,0,0" Focusable="False"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Button Name="CloseButton" Content="Close" HorizontalAlignment="Right" Width="80" Height="26" Margin="0,10,0,0" IsCancel="True"/>
    </StackPanel>
</Window>

<Window x:Class="AuroraPAR.LabelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora PAR - Labels" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="AuroraPAR.ico">
    <StackPanel Margin="12">
        <TextBlock TextWrapping="Wrap" MaxWidth="640" Foreground="Gray"
                   Text="Choose the number of rows and columns and the value shown in each cell. Empty rows are not shown; a label with no values shows only the track symbol. Changes are applied immediately."/>
        <GroupBox Header="Elevation (profile) label" Padding="8" Margin="0,10,0,0">
            <StackPanel Name="ElevationPanel"/>
        </GroupBox>
        <GroupBox Header="Azimuth label" Padding="8" Margin="0,10,0,0">
            <StackPanel Name="AzimuthPanel"/>
        </GroupBox>
        <CheckBox Name="RandomIdCheck" Margin="0,10,0,0"
                  Content="Track ID field: give each new track a random two-digit ID (01-99, never repeated in the session)"
                  ToolTip="For radars that receive neither the callsign nor the SSR code. An ID of your own: right click on the label, Set ID... (kept for the session; empty goes back to the random one)."/>
        <Button Name="CloseButton" Content="Close" HorizontalAlignment="Right" Width="80" Height="26" Margin="0,10,0,0" IsCancel="True"/>
    </StackPanel>
</Window>

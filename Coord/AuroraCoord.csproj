<Project Sdk="Microsoft.NET.Sdk">

  <!-- AuroraCoord: the coordination light panel as a standalone program (for the tower, who does not need the PAR display).
       It uses the same source files as the panel inside AuroraPAR, so the two always work together. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AuroraCoord</AssemblyName>
    <RootNamespace>AuroraPAR</RootNamespace>
    <ApplicationIcon>AuroraCoord.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Coordination.cs" Link="Coordination.cs" />
    <Compile Include="..\CoordinationWindow.cs" Link="CoordinationWindow.cs" />
    <Compile Include="..\ColorPicker.cs" Link="ColorPicker.cs" />
    <Compile Include="..\ColorText.cs" Link="ColorText.cs" />
    <!-- Own icon (light panel keys). Linked under the name the shared window loads (AuroraPAR.ico), so the window of
         AuroraCoord shows it while the panel inside AuroraPAR keeps the radar icon. -->
    <Resource Include="AuroraCoord.ico" Link="AuroraPAR.ico" />
    <!-- B612 cockpit font for the engraved texts (SIL Open Font License, see Fonts/B612-OFL.txt). -->
    <Resource Include="..\Fonts\B612-Bold.ttf" Link="Fonts\B612-Bold.ttf" />
    <!-- Sound of the coordination panel: the buzzer of the real light panel. -->
    <Resource Include="..\Sounds\coord-beep.wav" Link="Sounds\coord-beep.wav" />
    <Resource Include="..\Fonts\B612-Regular.ttf" Link="Fonts\B612-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- QR code of the phone panel link (MIT license). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AuroraPAR.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AuroraPAR.ico" />
    <!-- B612, the font of the Airbus cockpit displays (SIL Open Font License, see Fonts/B612-OFL.txt). -->
    <Resource Include="Fonts\B612-Bold.ttf" />
    <Resource Include="Fonts\B612-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="runways.par">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

<Window x:Class="AuroraPAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora PAR" Height="600" Width="800" Icon="AuroraPAR.ico"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <!-- Analog mode: controls styled as the parts of an old equipment (applied from the code, see ApplyDisplayMode). -->
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="./Fonts/#B612"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#D8D8D0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" SnapsToDevicePixels="True">
                            <Border CornerRadius="4" Background="#0E0F0D"/>
                            <Border x:Name="Cap" CornerRadius="4" BorderBrush="#0E0F0D" BorderThickness="1" Margin="0,0,0,3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6E706A" Offset="0"/>
                                        <GradientStop Color="#44463F" Offset="0.1"/>
                                        <GradientStop Color="#383A34" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="Hover" CornerRadius="3" Background="White" Opacity="0" IsHitTestVisible="False"/>
                                    <Ellipse x:Name="Lamp" Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Margin="6,5,0,0" Visibility="Collapsed" Fill="#1E281E" Stroke="#0E0F0D" StrokeThickness="0.8"/>
                                    <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Unlit">
                                <Setter TargetName="Lamp" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Lit">
                                <Setter TargetName="Lamp" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Lamp" Property="Fill" Value="#60FF60"/>
                                <Setter TargetName="Lamp" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#50FF50" ShadowDepth="0" BlurRadius="6" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cap" Property="Margin" Value="0,2,0,1"/>
                                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                                <Setter TargetName="Cap" Property="Background" Value="#2E302B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Window of the console readouts: dark with amber text. -->
        <Style x:Key="ConsoleBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="./Fonts/#B612"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFA830"/>
            <Setter Property="Background" Value="#0A0705"/>
            <Setter Property="BorderBrush" Value="#1A1B18"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#FFA830"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConsoleComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFA830"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2E14"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A3A18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ConsoleComboToggle" TargetType="ToggleButton">
            <Border Background="Transparent">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Data="M0,0 L4,4 L8,0 Z" Fill="#FFA830"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="ConsoleCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="./Fonts/#B612"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFA830"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ConsoleComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="#0A0705" BorderBrush="#1A1B18" BorderThickness="1.5" CornerRadius="2"/>
                            <ToggleButton Grid.ColumnSpan="2" Template="{StaticResource ConsoleComboToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="8,2,22,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="#FFA830" Margin="6,2,0,2" VerticalAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#16170F" BorderBrush="#8C8E88" BorderThickness="1"/>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Name="DisplayArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Analog mode: console panel with the digital readouts and status lamps. -->
            <!-- Scaled with the window: smaller in a small window, never wider than about a quarter of the display. -->
            <Border Grid.Column="0" Name="ConsoleHost" Visibility="Collapsed" Background="#2E302C" BorderBrush="#1A1B18" BorderThickness="0,0,1,0">
                <Viewbox Name="ConsoleViewbox" Stretch="Uniform" VerticalAlignment="Top"/>
            </Border>
            <Grid Grid.Column="1" Name="ScopeHost">
            <Grid Name="ScopeArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Canvas Name="Vertical" Grid.Row="0" Background="Black"/>
                <Canvas Name="Horizontal" Grid.Row="1" Background="Black"/>
            </Grid>
            <!-- Analog mode: frame of the round scope. -->
            <Canvas Name="BezelLayer" IsHitTestVisible="False" ClipToBounds="True"/>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Name="ControlPanel">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Selectors "on the fly". Shrinks (never grows) when the window is too low for all the controls. -->
            <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
            <StackPanel Width="100">
                <DockPanel Height="26" Margin="0,0,0,2"
                           ToolTip="Airport filter: type the ICAO (or its first letters) to list only its runways. Empty: all the airports in runways.par.&#x0a;Red: no airport starts with these letters (the list is not changed).&#x0a;The airport of the callsign connected in Aurora (e.g. LIPC_APP gives LIPC) is set here when you connect, whatever was typed. Not saved: empty at the next start.">
                    <TextBlock Name="IcaoLabel" Text="ICAO" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBox Name="IcaoFilterBox" CharacterCasing="Upper" MaxLength="4" VerticalContentAlignment="Center"/>
                </DockPanel>
                <ComboBox Name="RunwayComboBox" Height="30"/>
                <ComboBox Name="DistanceComboBox" Height="30"/>
                <StackPanel Name="GlidePathPanel" Margin="0,10,0,0">
                    <TextBlock Name="GlidePathLabel" Text="GP (°)" Margin="2,0,0,2"/>
                    <ComboBox Name="GlidePathComboBox" Height="26" IsEditable="True" IsTextSearchEnabled="False"/>
                </StackPanel>
                <StackPanel Margin="0,10,0,0"
                            ToolTip="Decision height for this session only: not saved, reset when the runway changes.">
                    <TextBlock Name="DhLabel" Text="DH (ft)" Margin="2,0,0,2"/>
                    <DockPanel Height="26">
                        <Button Name="DhDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                        <Button Name="DhUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                        <TextBox Name="DhTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Name="BrightnessPanel" Margin="0,10,0,0"
                            ToolTip="Brightness of the radar picture, 10% to 150% (above 100% the colours are boosted, for dim monitors). Also with the mouse wheel over it.">
                    <TextBlock Text="BRT" Margin="2,0,0,2"/>
                    <DockPanel Height="26">
                        <Button Name="BrightnessDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                        <Button Name="BrightnessUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                        <TextBlock Name="BrightnessText" Text="100%" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Name="TiltPanel" Margin="0,12,0,0"
                            ToolTip="Antenna tilt. Keyboard: arrows to tilt (up/down elevation, left/right azimuth), Home for neutral.">
                    <TextBlock Text="Antenna tilt" Margin="2,0,0,2"/>
                    <UniformGrid Columns="2" Height="26">
                        <Button Name="TiltUpButton" Content="EL ▲" Margin="0,0,1,0"/>
                        <Button Name="TiltDownButton" Content="EL ▼" Margin="1,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Height="26" Margin="0,2,0,0">
                        <Button Name="TiltLeftButton" Content="AZ L" Margin="0,0,1,0"/>
                        <Button Name="TiltRightButton" Content="AZ R" Margin="1,0,0,0"/>
                    </UniformGrid>
                    <Button Name="TiltNeutralButton" Content="Neutral" Height="26" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Analog mode: knobs instead of the range box, tilt buttons and DH buttons. -->
                <StackPanel Name="KnobPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
                <Button Name="LabelsButton" Content="Hide labels (L)" Margin="0,16,0,0" Height="26"
                        ToolTip="Show or hide the labels of all tracks (key L). Showing them again also brings back the labels hidden one by one. Right click on a label (or near its track) hides only that one; right click near the track shows it again."/>
            </StackPanel>
            </Viewbox>
            <!-- System buttons, fixed at the bottom edge, apart from the selectors. -->
            <StackPanel Grid.Row="1" Width="100" VerticalAlignment="Bottom" Margin="0,6,0,4">
                <Border Height="1" Background="#55808080" Margin="0,0,0,6"/>
                <Button Name="ModeButton" Content="Analog (A)" Margin="0,4,0,0" Height="26"
                        ToolTip="Switch between the modern display and the analog scope (key A)."/>
                <Button Name="CoordinationButton" Content="Coordination" Margin="0,4,0,0" Height="26"
                        ToolTip="Coordination light panel with the tower (voiceless coordination)."/>
                <Border Height="1" Background="#55808080" Margin="0,8,0,4"/>
                <Button Name="SettingsButton" Content="Settings..." Margin="0,4,0,0" Height="30"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
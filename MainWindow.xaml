<Window x:Class="AuroraPAR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora PAR" Height="600" Width="800" Icon="AuroraPAR.ico"
        MouseWheel="Window_MouseWheel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Canvas Name="Vertical" Grid.Row="0" Background="Black"/>
            <Canvas Name="Horizontal" Grid.Row="1" Background="Black"/>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ComboBox Grid.Row="0" Name="RunwayComboBox"></ComboBox>
            <ComboBox Grid.Row="1" Name="DistanceComboBox"></ComboBox>
            <Button Grid.Row="2" Name="SettingsButton" Content="Settings..." Margin="0,4,0,0"/>
            <StackPanel Grid.Row="3" Margin="0,10,0,0"
                        ToolTip="Decision height for this session only: not saved, reset when the runway changes.">
                <TextBlock Text="DH (ft)" Margin="2,0,0,2"/>
                <DockPanel Height="26">
                    <Button Name="DhDownButton" Content="−" Width="26" DockPanel.Dock="Left"/>
                    <Button Name="DhUpButton" Content="+" Width="26" DockPanel.Dock="Right"/>
                    <TextBox Name="DhTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>